<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.inventorydashboard.controller.InventoryController">
    <top>
        <Label text="Inventory Management" style="-fx-font-size: 20; -fx-font-weight: bold;" BorderPane.alignment="CENTER"/>
    </top>

    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="12" right="12" bottom="12" left="12"/>
            </padding>

            <TableView fx:id="productTable" prefHeight="300">
                <columns>
                    <TableColumn fx:id="idCol" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="nameCol" text="Name" prefWidth="150"/>
                    <TableColumn fx:id="skuCol" text="SKU" prefWidth="100"/>
                    <TableColumn fx:id="categoryCol" text="Category" prefWidth="120"/>
                    <TableColumn fx:id="supplierCol" text="Supplier" prefWidth="80"/>
                    <TableColumn fx:id="unitPriceCol" text="Cost" prefWidth="80"/>
                    <TableColumn fx:id="sellingPriceCol" text="Selling" prefWidth="80"/>
                    <TableColumn fx:id="stockCol" text="Stock" prefWidth="80"/>
                    <TableColumn fx:id="reorderCol" text="Reorder" prefWidth="80"/>
                    <TableColumn fx:id="statusCol" text="Status" prefWidth="100"/>
                </columns>
            </TableView>

            <GridPane hgap="10" vgap="10">
                <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="SKU:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <TextField fx:id="skuField" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                <Label text="Category:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="categoryField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Supplier ID:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                <TextField fx:id="supplierIdField" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                <Label text="Cost Price:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="unitPriceField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Selling Price:" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                <TextField fx:id="sellingPriceField" GridPane.rowIndex="2" GridPane.columnIndex="3"/>

                <Label text="Stock:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="stockField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Reorder Point:" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
                <TextField fx:id="reorderPointField" GridPane.rowIndex="3" GridPane.columnIndex="3"/>
            </GridPane>

            <HBox spacing="10">
                <Button text="Add" onAction="#addProduct"/>
                <Button text="Update" onAction="#updateProduct"/>
                <Button text="Archive" onAction="#archiveProduct"/>
                <Button text="Clear" onAction="#clearForm"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
